DLG_WHAT DIALOG LOADONCALL MOVEABLE DISCARDABLE 30, 32, 216, 132
FONT 8, "Helv"
STYLE WS_POPUP | WS_DLGFRAME
BEGIN
	CONTROL "Kye.  version 2.0", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 19, 6, 59, 8
	CONTROL "idi_kye", -1, "STATIC", SS_ICON | WS_CHILD | WS_VISIBLE, 0, 0, 18, 20
	CONTROL "scf", -1, "STATIC", SS_ICON | WS_CHILD | WS_VISIBLE, 198, 0, 18, 20
	CONTROL "Save the Children", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 136, 6, 61, 8
	CONTROL "If you enjoyed playing this game, spare a thought for those", -1, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 3, 22, 211, 8
	CONTROL "who can't. Send some money to support Save the Children.", -1, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 3, 30, 211, 8
	CONTROL "Queries:", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 50, 28, 8
	CONTROL "Colin Garbutt", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 165, 50, 44, 8
	CONTROL "(0736) 794932", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 165, 58, 51, 8
	CONTROL "See Help screen for details of where the money goes.", -1, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 3, 38, 211, 8
	CONTROL "Send money to:", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 0, 50, 53, 8
	CONTROL "What you get:", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 0, 89, 49, 8
	CONTROL "£10 and over:", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 0, 98, 49, 8
	CONTROL "£20 and over:", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 0, 114, 48, 8
	CONTROL "OK", 1, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 156, 114, 47, 14
	CONTROL "Save the Children,", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 55, 50, 63, 8
	CONTROL "Credit Cards:", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 0, 77, 46, 8
	CONTROL "(0736) 794932", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 48, 77, 54, 8
	CONTROL "Higher Hannaford, Poundsgate,", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 16, 58, 106, 8
	CONTROL "Newton Abbot, Devon, TQ13 7NX", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 16, 66, 118, 8
	CONTROL "Kye", -1, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 145, 82, 65, 9
	CONTROL "Copyright (c) 1992", -1, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 145, 90, 65, 8
	CONTROL "Colin Garbutt", -1, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 145, 98, 65, 8
	CONTROL "", 101, "BUTTON", BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 142, 76, 72, 34
	CONTROL "Many thanks, plus how", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 50, 98, 80, 8
	CONTROL "to remove this appeal.", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 50, 106, 90, 8
	CONTROL "As above, latest version of ", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 50, 114, 101, 8
	CONTROL "Kye plus 20+ more levels.", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 50, 122, 91, 8
