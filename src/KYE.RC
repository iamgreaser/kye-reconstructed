KYE MENU LOADONCALL MOVEABLE DISCARDABLE 
BEGIN
	POPUP "&Game"
	BEGIN
		MENUITEM "&New Game", 101
		MENUITEM "&Exit", 102
	END

	POPUP "&Level"
	BEGIN
		MENUITEM "&Restart level", 201
		MENUITEM "&Goto level...", 202
		MENUITEM "&File...", 203
		MENUITEM "&Edit", 204
	END

	POPUP "&Help"
	BEGIN
		MENUITEM "&The Game", 901
		MENUITEM "&Using Help", 902
		MENUITEM SEPARATOR
		MENUITEM "&About Kye...", 909
	END

END


DLG_DUN1 DIALOG LOADONCALL MOVEABLE DISCARDABLE 8, 26, 191, 82
STYLE WS_POPUP | WS_DLGFRAME | WS_SYSMENU
BEGIN
	CONTROL "OK", 1, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 70, 60, 47, 16
	CONTROL "text", 106, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 13, 25, 166, 20
	CONTROL "Level Finished.", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 5, 55, 8
	CONTROL "", -1, "STATIC", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 10, 19, 170, 30
END


