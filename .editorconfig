root = true

[*]
end_of_line = lf
trim_trailing_whitespace = true

[*.{c,h,cpp,C,H,CPP}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 8

[*.mak]
indent_style = tab
indent_size = 8

[*.{sh,bat}]
indent_style = space
indent_size = 2

[*.txt]
indent_style = space
indent_size = 2

[*.MAP]
end_of_line = crlf
